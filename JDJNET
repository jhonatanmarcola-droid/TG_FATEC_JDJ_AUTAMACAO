  display.clearDisplay();
  display.setTextColor(SSD1306_WHITE);

  switch (currentState) {
    case STATE_MAIN_SCREEN:
      display.setTextSize(1);
      display.setCursor(0, 0);
      display.println(F("--- JDJ NET: PRONTO ---"));
      display.setCursor(0, 12);
      display.printf("Vol: %.1f L | Agua: %.0f%%\n", totalVolume, waterPercentage);
      display.printf("Brix Alvo: %.1f Bx\n", targetBrixPct);
      display.printf("Agita: %ds | Vel: %d%%\n", mixingTimeSec, motorSpeedPct);
      display.setCursor(0, 42);
      display.printf("Brix Instant: %.1f Bx\n", currentBrixValue);
      display.setCursor(0, 54);
      display.println(F("[VERDE] Iniciar Ciclo"));
