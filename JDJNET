#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>
#include <WiFi.h>
#include <PubSubClient.h>

// --- CONFIGURAÇÃO DA REDE WI-FI E BROKER MQTT ---
const char* WIFI_SSID       = "Wokwi-GUEST"; // No hardware real, altere para sua rede
const char* WIFI_PASSWORD   = "";
const char* MQTT_BROKER     = "broker.hivemq.com"; // Broker público (ou IP do seu Mosquitto/Influx)
const int   MQTT_PORT       = 1883;

WiFiClient espClient;
PubSubClient mqttClient(espClient);

// --- OLED DISPLAY CONFIGURATION ---
#define SCREEN_WIDTH 128
#define SCREEN_HEIGHT 64
Adafruit_SSD1306 display(SCREEN_WIDTH, SCREEN_HEIGHT, &Wire, -1);

// --- PINOUT: BUTTONS & INDICATORS ---
#define LED_DOSING_PIN    2
#define BUZZER_PIN       15

#define BTN_YELLOW_PIN   25 // Navigation / Menu
#define BTN_GREEN_PIN    27 // Confirm / Start Dosing / Quality Check
#define BTN_RED_PIN      14 // Cancel / Abort / Reset Error
#define BTN_BLACK_PIN    26 // Decrement (-) / Purge Solenoid B (Oil)
#define BTN_BLUE_PIN     12 // Increment (+) / Purge Solenoid A (Water) / Unlock Tech Menu

// --- PINOUT: HYDRAULICS, MOTOR & SENSORS ---
#define SOLENOID_WATER_PIN   18
#define SOLENOID_OIL_PIN     19
#define MOTOR_PWM_PIN         5 // MOSFET Driver for Mixer Motor (PWM)

#define FLOAT_SWITCH_PIN      4 // Safety High Level Switch
#define WATER_FLOW_SENSOR_PIN 32 // Water Flow Sensor (YF-S201)
#define OIL_FLOW_SENSOR_PIN   33 // Oil Flow Sensor
#define BRIX_SENSOR_PIN       34 // Brix Sensor / Potentiometer (ADC)

// --- MOTOR PWM CONFIGURATION (ESP32) ---
const int PWM_FREQ = 5000;       
const int PWM_RESOLUTION = 8;    
const int PWM_CHANNEL = 0;

// Flow Sensor Calibration Factor (Pulses per Liter for YF-S201)
const float PULSES_PER_LITER = 450.0; 

// Pulse Counters
volatile unsigned long waterPulseCount = 0;
volatile unsigned long oilPulseCount = 0;

void IRAM_ATTR countWaterPulses() { waterPulseCount++; }
void IRAM_ATTR countOilPulses() { oilPulseCount++; }

// --- FINITE STATE MACHINE (FSM) ---
enum SystemState {
  STATE_MAIN_SCREEN,
  STATE_MENU1_TOTAL_VOL,
  STATE_MENU_LOCKED,       
  STATE_MENU2_WATER_PCT,
  STATE_MENU3_TARGET_BRIX, 
  STATE_MENU4_MOTOR_SPEED,
  STATE_MENU5_MIX_TIME,
  STATE_MENU6_PURGE,
  STATE_DOSING,
  STATE_MIXING,
  STATE_QUALITY_CHECK,
  STATE_ERROR_HIGH_LEVEL
};

SystemState currentState = STATE_MAIN_SCREEN;

// --- INITIAL SYSTEM PARAMETERS ---
float totalVolume = 5.0;       // Liters
float waterPercentage = 90.0;  // Water % (90% Water / 10% Oil)
float targetBrixPct = 10.0;    // Target Brix Percentage (0 to 40.0 °Brix)
int motorSpeedPct = 70;        // Motor speed percentage (0-75%)
int mixingTimeSec = 10;        // Agitation time in seconds

// --- BRIX QUALITY CONFIGURATION ---
const float BRIX_TOLERANCE = 1.0; 

float expectedTargetBrix = 0.0;
float finalMeasuredBrix = 0.0;
bool isProductApproved = false;

// Temporary Variables for Menu Editing
float tempTotalVolume = 5.0;
float tempWaterPercentage = 90.0;
float tempTargetBrixPct = 10.0;
int tempMotorSpeedPct = 70;
int tempMixingTimeSec = 10;

// Calculated Targets
float targetWaterVol = 0.0;
float targetOilVol = 0.0;

bool isWaterSolenoidActive = false;
bool isOilSolenoidActive = false;

// Timing & Controls via millis()
unsigned long mixingStartTime = 0;
unsigned long lastButtonDebounce = 0;
unsigned long lastMQTTTelemetry = 0;
const unsigned long DEBOUNCE_DELAY = 180; // ms

// Brix Sensor Reading
float currentBrixValue = 0.0;

// --- AUDIO FEEDBACK FUNCTIONS ---
void playSoftSound(int frequency, int durationMs) {
  tone(BUZZER_PIN, frequency, durationMs);
  delay(durationMs);
  noTone(BUZZER_PIN);
}

void playButtonBeep() { playSoftSound(2200, 15); }
void playStartDosingBeep() { playSoftSound(1500, 120); }
void playApprovedBeep() { playSoftSound(1200, 40); delay(20); playSoftSound(1600, 60); }
void playRejectedBeep() { playSoftSound(600, 150); delay(30); playSoftSound(400, 200); }
void playStartupBeep() { playSoftSound(1800, 30); delay(30); playSoftSound(2200, 40); }
void playErrorAlarm() {
  for (int i = 0; i < 3; i++) {
    playSoftSound(900, 100);
    delay(80);
  }
}

// --- MOTOR PWM CONTROL FUNCTIONS ---
void setMotorPWM(int percentage) {
  int pwmValue = map(percentage, 0, 100, 0, 255);
  #if defined(ESP_ARDUINO_VERSION_MAJOR) && ESP_ARDUINO_VERSION_MAJOR >= 3
    ledcWrite(MOTOR_PWM_PIN, pwmValue);
  #else
    ledcWrite(PWM_CHANNEL, pwmValue);
  #endif
}

void stopMotorPWM() {
  #if defined(ESP_ARDUINO_VERSION_MAJOR) && ESP_ARDUINO_VERSION_MAJOR >= 3
    ledcWrite(MOTOR_PWM_PIN, 0);
  #else
    ledcWrite(PWM_CHANNEL, 0);
  #endif
}

// --- FORWARD DECLARATION OF FUNCTIONS ---
void processButtons();
void readBrixSensor();
void checkFloatSwitchSafety();
void processDosing();
void processMixing();
void startDosing();
void stopProcess();
void updateOLED();
void setupWiFiMQTT();
void handleMQTTConnection();
void publishTelemetry();
void mqttCallback(char* topic, byte* payload, unsigned int length);

void setup() {
  Serial.begin(115200);

  pinMode(LED_DOSING_PIN, OUTPUT);
  digitalWrite(LED_DOSING_PIN, LOW);

  pinMode(BUZZER_PIN, OUTPUT);
  digitalWrite(BUZZER_PIN, LOW);

  pinMode(SOLENOIDE_WATER_PIN, OUTPUT);
  pinMode(SOLENOIDE_OIL_PIN, OUTPUT);

  digitalWrite(SOLENOIDE_WATER_PIN, LOW);
  digitalWrite(SOLENOIDE_OIL_PIN, LOW);

  #if defined(ESP_ARDUINO_VERSION_MAJOR) && ESP_ARDUINO_VERSION_MAJOR >= 3
    ledcAttachChannel(MOTOR_PWM_PIN, PWM_FREQ, PWM_RESOLUTION, PWM_CHANNEL);
  #else
    ledcSetup(PWM_CHANNEL, PWM_FREQ, PWM_RESOLUTION);
    ledcAttachPin(MOTOR_PWM_PIN, PWM_CHANNEL);
  #endif
  stopMotorPWM();

  pinMode(BTN_YELLOW_PIN, INPUT_PULLUP);
  pinMode(BTN_GREEN_PIN, INPUT_PULLUP);
  pinMode(BTN_RED_PIN, INPUT_PULLUP);
  pinMode(BTN_BLACK_PIN, INPUT_PULLUP);
  pinMode(BTN_BLUE_PIN, INPUT_PULLUP);

  pinMode(FLOAT_SWITCH_PIN, INPUT_PULLUP);
  pinMode(WATER_FLOW_SENSOR_PIN, INPUT_PULLUP);
  pinMode(OIL_FLOW_SENSOR_PIN, INPUT_PULLUP);
  pinMode(BRIX_SENSOR_PIN, INPUT);

  attachInterrupt(digitalPinToInterrupt(WATER_FLOW_SENSOR_PIN), countWaterPulses, FALLING);
  attachInterrupt(digitalPinToInterrupt(OIL_FLOW_SENSOR_PIN), countOilPulses, FALLING);

  if (!display.begin(SSD1306_SWITCHCAPVCC, 0x3C)) {
    Serial.println(F("Erro ao iniciar display OLED!"));
    for (;;);
  }

  playStartupBeep();

  display.clearDisplay();
  display.setTextColor(SSD1306_WHITE);
  display.setTextSize(1);
  display.setCursor(15, 15);
  display.println(F("JDJ NET v3.0"));
  display.setCursor(10, 35);
  display.println(F("Conectando Wi-Fi..."));
  display.display();

  setupWiFiMQTT();
  updateOLED();
}

void loop() {
  handleMQTTConnection();
  processButtons();
  readBrixSensor();
  checkFloatSwitchSafety();

  if (currentState == STATE_DOSING) {
    processDosing();
  } else if (currentState == STATE_MIXING) {
    processMixing();
  } else {
    static unsigned long lastOLEDUpdate = 0;
    if (millis() - lastOLEDUpdate > 250) {
      lastOLEDUpdate = millis();
      updateOLED();
    }
  }

  // Publica telemetria no Broker a cada 500ms
  if (millis() - lastMQTTTelemetry > 500) {
    lastMQTTTelemetry = millis();
    publishTelemetry();
  }
}

// --- REDE WI-FI E COMUNICAÇÃO MQTT ---
void setupWiFiMQTT() {
  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);
  int tentativas = 0;
  while (WiFi.status() != WL_CONNECTED && tentativas < 15) {
    delay(300);
    tentativas++;
  }

  mqttClient.setServer(MQTT_BROKER, MQTT_PORT);
  mqttClient.setCallback(mqttCallback);
}

void handleMQTTConnection() {
  if (!mqttClient.connected()) {
    if (WiFi.status() == WL_CONNECTED) {
      String clientId = "JDJ_NET_ESP32_" + String(random(0xffff), HEX);
      if (mqttClient.connect(clientId.c_str())) {
        mqttClient.subscribe("jdjpro/cmd/start");
        mqttClient.subscribe("jdjpro/cmd/abort");
        mqttClient.subscribe("jdjpro/cmd/set_brix");
        mqttClient.subscribe("jdjpro/cmd/set_volume");
      }
    }
  } else {
    mqttClient.loop();
  }
}

void publishTelemetry() {
  if (!mqttClient.connected()) return;

  float currentWaterVol = waterPulseCount / PULSES_PER_LITER;
  float currentOilVol = oilPulseCount / PULSES_PER_LITER;

  mqttClient.publish("jdjpro/telemetry/brix", String(currentBrixValue, 1).c_str());
  mqttClient.publish("jdjpro/telemetry/water_vol", String(currentWaterVol, 2).c_str());
  mqttClient.publish("jdjpro/telemetry/oil_vol", String(currentOilVol, 2).c_str());
  mqttClient.publish("jdjpro/telemetry/target_vol", String(totalVolume, 1).c_str());

  String statusStr = "IDLE";
  if (currentState == STATE_DOSING) statusStr = "DOSING";
  else if (currentState == STATE_MIXING) statusStr = "MIXING";
  else if (currentState == STATE_QUALITY_CHECK) statusStr = isProductApproved ? "APPROVED" : "REJECTED";
  else if (currentState == STATE_ERROR_HIGH_LEVEL) statusStr = "ALARM_HIGH_LEVEL";

  mqttClient.publish("jdjpro/telemetry/status", statusStr.c_str());
}

void mqttCallback(char* topic, byte* payload, unsigned int length) {
  String message = "";
  for (unsigned int i = 0; i < length; i++) {
    message += (char)payload[i];
  }

  if (String(topic) == "jdjpro/cmd/start") {
    if (currentState == STATE_MAIN_SCREEN) startDosing();
  }
  else if (String(topic) == "jdjpro/cmd/abort") {
    if (currentState == STATE_DOSING || currentState == STATE_MIXING) stopProcess();
  }
  else if (String(topic) == "jdjpro/cmd/set_brix") {
    float val = message.toFloat();
    if (val >= 0.0 && val <= 40.0) targetBrixPct = val;
  }
  else if (String(topic) == "jdjpro/cmd/set_volume") {
    float val = message.toFloat();
    if (val >= 0.5 && val <= 7.0) totalVolume = val;
  }
}

void checkFloatSwitchSafety() {
  bool isHighLevelReached = (digitalRead(FLOAT_SWITCH_PIN) == HIGH);

  if (isHighLevelReached && (currentState == STATE_DOSING || currentState == STATE_MIXING)) {
    stopProcess();
    currentState = STATE_ERROR_HIGH_LEVEL;
    playErrorAlarm();
    updateOLED();
  }
}

void readBrixSensor() {
  static float filteredBrix = -1.0;
  int rawADC = analogRead(BRIX_SENSOR_PIN);
  float instantBrix = (rawADC / 4095.0) * 40.0; 
  
  if (filteredBrix < 0) {
    filteredBrix = instantBrix;
  } else {
    filteredBrix = (filteredBrix * 0.9) + (instantBrix * 0.1);
  }
  currentBrixValue = filteredBrix;
}

void startDosing() {
  if (digitalRead(FLOAT_SWITCH_PIN) == HIGH) {
    currentState = STATE_ERROR_HIGH_LEVEL;
    playErrorAlarm();
    updateOLED();
    return;
  }

  playStartDosingBeep();

  waterPulseCount = 0;
  oilPulseCount = 0;

  targetWaterVol = totalVolume * (waterPercentage / 100.0);
  targetOilVol = totalVolume - targetWaterVol;

  expectedTargetBrix = targetBrixPct;

  isWaterSolenoidActive = (targetWaterVol > 0);
  isOilSolenoidActive = (targetOilVol > 0);

  digitalWrite(SOLENOIDE_WATER_PIN, isWaterSolenoidActive ? HIGH : LOW);
  digitalWrite(SOLENOIDE_OIL_PIN, isOilSolenoidActive ? HIGH : LOW);
  stopMotorPWM();
  digitalWrite(LED_DOSING_PIN, HIGH);

  currentState = STATE_DOSING;
}

void processDosing() {
  float currentWaterVol = waterPulseCount / PULSES_PER_LITER;
  float currentOilVol = oilPulseCount / PULSES_PER_LITER;

  if (isWaterSolenoidActive && currentWaterVol >= targetWaterVol) {
    digitalWrite(SOLENOIDE_WATER_PIN, LOW);
    isWaterSolenoidActive = false;
  }

  if (isOilSolenoidActive && currentOilVol >= targetOilVol) {
    digitalWrite(SOLENOIDE_OIL_PIN, LOW);
    isOilSolenoidActive = false;
  }

  if (!isWaterSolenoidActive && !isOilSolenoidActive) {
    digitalWrite(SOLENOIDE_WATER_PIN, LOW);
    digitalWrite(SOLENOIDE_OIL_PIN, LOW);
    
    setMotorPWM(motorSpeedPct);
    mixingStartTime = millis();
    currentState = STATE_MIXING;
  }

  updateOLED();
}

void processMixing() {
  unsigned long elapsedTimeMs = millis() - mixingStartTime;
  unsigned long totalTargetTimeMs = (unsigned long)mixingTimeSec * 1000;

  if (elapsedTimeMs >= totalTargetTimeMs) {
    stopMotorPWM();
    digitalWrite(LED_DOSING_PIN, LOW);
    
    finalMeasuredBrix = currentBrixValue;
    float brixError = abs(finalMeasuredBrix - expectedTargetBrix);
    isProductApproved = (brixError <= BRIX_TOLERANCE);

    currentState = STATE_QUALITY_CHECK;

    if (isProductApproved) {
      playApprovedBeep();
    } else {
      playRejectedBeep();
    }
  }

  updateOLED();
}

void stopProcess() {
  digitalWrite(SOLENOIDE_WATER_PIN, LOW);
  digitalWrite(SOLENOIDE_OIL_PIN, LOW);
  stopMotorPWM();
  digitalWrite(LED_DOSING_PIN, LOW);
  noTone(BUZZER_PIN);
  isWaterSolenoidActive = false;
  isOilSolenoidActive = false;
  currentState = STATE_MAIN_SCREEN;
}

void processButtons() {
  if ((millis() - lastButtonDebounce) < DEBOUNCE_DELAY) return;

  static bool prevYellowState = HIGH;
  static bool prevGreenState = HIGH;
  static bool prevRedState = HIGH;
  static bool prevBlackState = HIGH;
  static bool prevBlueState = HIGH;

  bool currentYellowState = digitalRead(BTN_YELLOW_PIN);
  bool currentGreenState = digitalRead(BTN_GREEN_PIN);
  bool currentRedState = digitalRead(BTN_RED_PIN);
  bool currentBlackState = digitalRead(BTN_BLACK_PIN);
  bool currentBlueState = digitalRead(BTN_BLUE_PIN);

  if (currentYellowState == LOW && prevYellowState == HIGH) {
    lastButtonDebounce = millis();
    playButtonBeep();

    if (currentState == STATE_MAIN_SCREEN) {
      tempTotalVolume = totalVolume;
      tempWaterPercentage = waterPercentage;
      tempTargetBrixPct = targetBrixPct;
      tempMotorSpeedPct = motorSpeedPct;
      tempMixingTimeSec = mixingTimeSec;
      currentState = STATE_MENU1_TOTAL_VOL;
    } 
    else if (currentState == STATE_MENU1_TOTAL_VOL) {
      currentState = STATE_MENU_LOCKED;
    }
    else if (currentState == STATE_MENU2_WATER_PCT) {
      currentState = STATE_MENU3_TARGET_BRIX;
    }
    else if (currentState == STATE_MENU3_TARGET_BRIX) {
      currentState = STATE_MENU4_MOTOR_SPEED;
    }
    else if (currentState == STATE_MENU4_MOTOR_SPEED) {
      currentState = STATE_MENU5_MIX_TIME;
    }
    else if (currentState == STATE_MENU5_MIX_TIME) {
      currentState = STATE_MENU6_PURGE;
    }
    else if (currentState == STATE_MENU6_PURGE) {
      totalVolume = tempTotalVolume;
      waterPercentage = tempWaterPercentage;
      targetBrixPct = tempTargetBrixPct;
      motorSpeedPct = tempMotorSpeedPct;
      mixingTimeSec = tempMixingTimeSec;
      digitalWrite(SOLENOIDE_WATER_PIN, LOW);
      digitalWrite(SOLENOIDE_OIL_PIN, LOW);
      currentState = STATE_MAIN_SCREEN;
    }
    updateOLED();
  }

  if (currentState == STATE_MENU_LOCKED) {
    if (currentBlueState == LOW && prevBlueState == HIGH) {
      lastButtonDebounce = millis();
      playButtonBeep();
      currentState = STATE_MENU2_WATER_PCT;
      updateOLED();
    }
  }

  if (currentGreenState == LOW && prevGreenState == HIGH) {
    lastButtonDebounce = millis();
    playButtonBeep();

    if (currentState >= STATE_MENU1_TOTAL_VOL && currentState <= STATE_MENU6_PURGE) {
      totalVolume = tempTotalVolume;
      waterPercentage = tempWaterPercentage;
      targetBrixPct = tempTargetBrixPct;
      motorSpeedPct = tempMotorSpeedPct;
      mixingTimeSec = tempMixingTimeSec;
      digitalWrite(SOLENOIDE_WATER_PIN, LOW);
      digitalWrite(SOLENOIDE_OIL_PIN, LOW);
      currentState = STATE_MAIN_SCREEN;
    }
    else if (currentState == STATE_MAIN_SCREEN) {
      startDosing();
    }
    else if (currentState == STATE_QUALITY_CHECK) {
      currentState = STATE_MAIN_SCREEN;
    }
    updateOLED();
  }

  if (currentRedState == LOW && prevRedState == HIGH) {
    lastButtonDebounce = millis();
    playButtonBeep();

    if (currentState == STATE_DOSING || currentState == STATE_MIXING) {
      stopProcess();
    } else {
      digitalWrite(SOLENOIDE_WATER_PIN, LOW);
      digitalWrite(SOLENOIDE_OIL_PIN, LOW);
      currentState = STATE_MAIN_SCREEN;
    }
    updateOLED();
  }

  if (currentState == STATE_MENU6_PURGE) {
    if (currentBlackState == LOW) {
      digitalWrite(SOLENOIDE_OIL_PIN, HIGH);
    } else {
      digitalWrite(SOLENOIDE_OIL_PIN, LOW);
    }
  } 
  else if (currentBlackState == LOW && prevBlackState == HIGH && currentState != STATE_DOSING && currentState != STATE_MIXING && currentState != STATE_QUALITY_CHECK) {
    lastButtonDebounce = millis();
    playButtonBeep();

    if (currentState == STATE_MENU1_TOTAL_VOL) {
      tempTotalVolume -= 0.5;
      if (tempTotalVolume < 0.5) tempTotalVolume = 0.5;
    } 
    else if (currentState == STATE_MENU2_WATER_PCT) {
      tempWaterPercentage -= 1.0;
      if (tempWaterPercentage < 0.0) tempWaterPercentage = 0.0;
    } 
    else if (currentState == STATE_MENU3_TARGET_BRIX) {
      tempTargetBrixPct -= 0.5;
      if (tempTargetBrixPct < 0.0) tempTargetBrixPct = 0.0;
    }
    else if (currentState == STATE_MENU4_MOTOR_SPEED) {
      tempMotorSpeedPct -= 5;
      if (tempMotorSpeedPct < 10) tempMotorSpeedPct = 10;
    }
    else if (currentState == STATE_MENU5_MIX_TIME) {
      tempMixingTimeSec -= 1;
      if (tempMixingTimeSec < 1) tempMixingTimeSec = 1;
    }
    updateOLED();
  }

  if (currentState == STATE_MENU6_PURGE) {
    if (currentBlueState == LOW) {
      digitalWrite(SOLENOIDE_WATER_PIN, HIGH);
    } else {
      digitalWrite(SOLENOIDE_WATER_PIN, LOW);
    }
  } 
  else if (currentBlueState == LOW && prevBlueState == HIGH && currentState != STATE_DOSING && currentState != STATE_MIXING && currentState != STATE_QUALITY_CHECK && currentState != STATE_MENU_LOCKED) {
    lastButtonDebounce = millis();
    playButtonBeep();

    if (currentState == STATE_MENU1_TOTAL_VOL) {
      tempTotalVolume += 0.5;
      if (tempTotalVolume > 7.0) tempTotalVolume = 7.0;
    } 
    else if (currentState == STATE_MENU2_WATER_PCT) {
      tempWaterPercentage += 1.0;
      if (tempWaterPercentage > 100.0) tempWaterPercentage = 100.0;
    } 
    else if (currentState == STATE_MENU3_TARGET_BRIX) {
      tempTargetBrixPct += 0.5;
      if (tempTargetBrixPct > 40.0) tempTargetBrixPct = 40.0;
    }
    else if (currentState == STATE_MENU4_MOTOR_SPEED) {
      tempMotorSpeedPct += 5;
      if (tempMotorSpeedPct > 75) tempMotorSpeedPct = 75;
    }
    else if (currentState == STATE_MENU5_MIX_TIME) {
      tempMixingTimeSec += 1;
      if (tempMixingTimeSec > 60) tempMixingTimeSec = 60;
    }
    updateOLED();
  }

  prevYellowState = currentYellowState;
  prevGreenState = currentGreenState;
  prevRedState = currentRedState;
  prevBlackState = currentBlackState;
  prevBlueState = currentBlueState;
}

