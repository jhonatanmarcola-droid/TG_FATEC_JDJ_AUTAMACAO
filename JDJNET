      display.println(F("MENU 3/6: % BRIX ALVO"));
      display.setTextSize(2);
      display.setCursor(10, 20);
      display.printf("%.1f Bx", tempTargetBrixPct);
      display.setTextSize(1);
      display.setCursor(0, 44);
      display.println(F("[-]Preto  [+]Azul"));
      display.setCursor(0, 55);
      display.println(F("[VERDE] OK/Sair"));
      break;

    case STATE_MENU4_MOTOR_SPEED:
      display.setTextSize(1);
      display.setCursor(0, 0);
      display.println(F("MENU 4/6: VEL. MOTOR"));
      display.setTextSize(2);
      display.setCursor(25, 20);
      display.printf("%d %%", tempMotorSpeedPct);
      display.setTextSize(1);
      display.setCursor(0, 44);
      display.println(F("[-]Preto  [+]Azul"));
      display.setCursor(0, 55);
      display.println(F("[VERDE] OK/Sair"));
      break;

    case STATE_MENU5_MIX_TIME:
      display.setTextSize(1);
      display.setCursor(0, 0);
      display.println(F("MENU 5/6: TEMPO AGITA"));
      display.setTextSize(2);
      display.setCursor(20, 20);
      display.printf("%d seg", tempMixingTimeSec);
      display.setTextSize(1);
      display.setCursor(0, 44);
      display.println(F("[-]Preto  [+]Azul"));
      display.setCursor(0, 55);
      display.println(F("[VERDE] OK/Sair"));
      break;

    case STATE_MENU6_PURGE:
      display.setTextSize(1);
      display.setCursor(0, 0);
      display.println(F("MENU 6/6: DESPEJO LIVRE"));
      display.setCursor(0, 18);
      display.println(F("Segure p/ Acionar:"));
      display.setCursor(0, 32);
      display.println(F("[AZUL]  Solenoide Agua"));
      display.setCursor(0, 44);
      display.println(F("[PRETO] Solenoide Oleo"));
      display.setCursor(0, 55);
      display.println(F("[VERDE] Sair"));
      break;

    case STATE_DOSING: {
      float currentWaterVol = waterPulseCount / PULSES_PER_LITER;
      float currentOilVol = oilPulseCount / PULSES_PER_LITER;

      display.setTextSize(1);
      display.setCursor(0, 0);
      display.println(F("  >>> DOSANDO... <<<  "));
      display.setCursor(0, 16);
      display.printf("AGUA: %.2f/%.2f L\n", currentWaterVol, targetWaterVol);
      display.printf("OLEO: %.2f/%.2f L\n", currentOilVol, targetOilVol);
      display.setCursor(0, 36);
      display.printf("Brix Instant: %.1f Bx\n", currentBrixValue);
      display.setCursor(0, 48);
      if (isWaterSolenoidActive && isOilSolenoidActive) display.println(F("Solenoides: AMBAS"));
      else if (isWaterSolenoidActive) display.println(F("Sol: Apenas AGUA"));
      else if (isOilSolenoidActive) display.println(F("Sol: Apenas OLEO"));
      else display.println(F("Solenoides: FECHADAS"));
      break;
    }

    case STATE_MIXING: {
      unsigned long elapsedTimeSec = (millis() - mixingStartTime) / 1000;
      int timeRemainingSec = mixingTimeSec - (int)elapsedTimeSec;
      if (timeRemainingSec < 0) timeRemainingSec = 0;
      
      display.setTextSize(1);
      display.setCursor(0, 0);
      display.println(F(" >> MISTURANDO... << "));
      display.setCursor(0, 18);
      display.setTextSize(2);
      display.printf("  %d s", timeRemainingSec);
      display.setTextSize(1);
      display.setCursor(0, 42);
      display.printf("Brix Instant: %.1f Bx\n", currentBrixValue);
      display.setCursor(0, 54);
      display.printf("Motor Potencia: %d%%\n", motorSpeedPct);
      break;
    }

    case STATE_QUALITY_CHECK:
      display.setTextSize(1);
      display.setCursor(0, 0);
      display.println(F("-- TESTE DE QUALIDADE --"));
      display.setCursor(0, 14);
      display.printf("Brix Alvo: %.1f degBrix\n", expectedTargetBrix);
      display.printf("Brix Lido: %.1f degBrix\n", finalMeasuredBrix);
      display.setCursor(0, 36);
      if (isProductApproved) {
        display.println(F("STATUS: [ APROVADO ]"));
      } else {
        display.println(F("STATUS: [ REPROVADO ]"));
      }
      display.setCursor(0, 54);
      display.println(F("[VERDE] Concluir Batch"));
      break;

    case STATE_ERROR_HIGH_LEVEL:
      display.setTextSize(1);
      display.setCursor(0, 0);
      display.println(F("! ALARME SEGURANCA !"));
      display.setCursor(0, 20);
      display.println(F(" RESERVATORIO CHEIO "));
      display.println(F("   BOIA ACIONADA!   "));
      display.setCursor(0, 54);
      display.println(F("[VERMELHO] Resetar"));
      break;
  }

  display.display();
}
