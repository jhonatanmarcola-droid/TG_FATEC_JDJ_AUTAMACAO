#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>

// --- MAPEAMENTO DE PINOS ---
#define SCREEN_WIDTH 128
#define SCREEN_HEIGHT 64
#define OLED_RESET    -1
Adafruit_SSD1306 display(SCREEN_WIDTH, SCREEN_HEIGHT, &Wire, OLED_RESET);

// Pinos de Interface (I2C)
#define OLED_SDA      21
#define OLED_SCL      22

// Pinos de Controle (Botões)
#define BTN_AMARELO   25 // Menu (Avança/Salva no final)
#define BTN_PRETO     26 // Decremento / Purga Solenoide 1
#define BTN_VERDE     27 // Confirma Menu / Inicia Dosagem
#define BTN_VERMELHO  14 // Cancela Menu / Cancela Dosagem
#define BTN_AZUL      12 // Incremento / Purga Solenoide 2

// Pinos de Atuadores e Sensores
#define LED_VERDE     3  // Indicador de Dosagem
#define BUZZER        15 // Avisos Sonoros
#define SOLENOIDE_1   18 // Válvula 1 (Água - Fio Branco)
#define SOLENOIDE_2   19 // Válvula 2 (Líquido 2)
#define SENSOR_HALL_1 32 // Medidor de Fluxo 1
#define SENSOR_HALL_2 33 // Medidor de Fluxo 2

// --- CALIBRAÇÃO DE FLUXO ---
// Fator multiplicador. (Ex: se 1 clique/pulso = 1 mL, deixe 1.0)
// Se seu sensor der 5 pulsos para cada 1 mL, mude para 5.0
#define PULSOS_POR_ML 1.0 

// --- VARIÁVEIS GLOBAIS ---
int menuIndex = 0;             
int volumeTotal = 250;         
int percAgua = 50;             

// Variáveis temporárias para edição nos menus
int tempVolume = 250;
int tempPercAgua = 50;

// Controle de Processo
volatile int pulsosS1 = 0;
volatile int pulsosS2 = 0;
volatile unsigned long ultimoPulsoS1 = 0;
volatile unsigned long ultimoPulsoS2 = 0;

int alvoPulsosS1 = 0;
int alvoPulsosS2 = 0;
int ultimosPulsosS1 = -1; 
int ultimosPulsosS2 = -1;
bool dosando = false;
unsigned long tempoInicioDosagem = 0; // Trava contra cancelamento fantasma

// --- PROTÓTIPOS ---
void IRAM_ATTR contaPulsoS1();
void IRAM_ATTR contaPulsoS2();
void bipSutil();
void bipLigar();
void bipIniciar();
void bipSucesso();
void bipCancela();
void tratarBotoesMenu();
void iniciarCiclo();
void executarDosagem();
void pararAtuadores();
void atualizarDisplay();

// --- SETUP ---
void setup() {
  Serial.begin(115200);
  Wire.begin(OLED_SDA, OLED_SCL);

  // Configuração dos Pinos (Botões e Sensores em PULLUP interno)
  pinMode(BTN_AMARELO, INPUT_PULLUP);
  pinMode(BTN_PRETO, INPUT_PULLUP);
  pinMode(BTN_VERDE, INPUT_PULLUP);
  pinMode(BTN_VERMELHO, INPUT_PULLUP);
  pinMode(BTN_AZUL, INPUT_PULLUP);
  pinMode(SENSOR_HALL_1, INPUT_PULLUP);
  pinMode(SENSOR_HALL_2, INPUT_PULLUP);

  // Saídas
  pinMode(LED_VERDE, OUTPUT);
  pinMode(BUZZER, OUTPUT);
  pinMode(SOLENOIDE_1, OUTPUT);
  pinMode(SOLENOIDE_2, OUTPUT);

  // Garante válvulas fechadas na partida
  digitalWrite(LED_VERDE, LOW);
  digitalWrite(SOLENOIDE_1, LOW);
  digitalWrite(SOLENOIDE_2, LOW);

  // Interrupções para os sensores Hall
  attachInterrupt(digitalPinToInterrupt(SENSOR_HALL_1), contaPulsoS1, FALLING);
  attachInterrupt(digitalPinToInterrupt(SENSOR_HALL_2), contaPulsoS2, FALLING);

  // Inicialização do OLED
  if (!display.begin(SSD1306_SWITCHCAPVCC, 0x3C)) {
    Serial.println(F("Falha ao iniciar OLED"));
    while (1);
  }

  display.clearDisplay();
  display.setTextColor(SSD1306_WHITE);
  display.setTextSize(1);
  display.setCursor(25, 20);
  display.println(F("JDJ PRO v3.5"));
  display.setCursor(15, 40);
  display.println(F("Sistema Pronto"));
  display.display();

  bipLigar();
  delay(1500);
}

// --- LOOP PRINCIPAL ---
void loop() {
  if (dosando) {
    executarDosagem();
  } else {
    tratarBotoesMenu();
    atualizarDisplay();
  }
}

// --- FILTRO DE RUÍDO (DEBOUNCE) EM MICROSEGUNDOS ---
void IRAM_ATTR contaPulsoS1() {
  unsigned long tempoAtual = micros();
  // Trava de 25000 microssegundos (25ms) entre pulsos para evitar clique duplo/ruído
  if (dosando && (tempoAtual - ultimoPulsoS1 > 25000)) { 
    pulsosS1++;
    ultimoPulsoS1 = tempoAtual;
  }
}

void IRAM_ATTR contaPulsoS2() {
  unsigned long tempoAtual = micros();
  if (dosando && (tempoAtual - ultimoPulsoS2 > 25000)) { 
    pulsosS2++;
    ultimoPulsoS2 = tempoAtual;
  }
}

// --- GERENCIAMENTO DE MENUS ---
void tratarBotoesMenu() {
  // Botão AMARELO: Navega menus e salva
  if (digitalRead(BTN_AMARELO) == LOW) {
    bipSutil();
    menuIndex++;
    if (menuIndex > 3) {
      volumeTotal = tempVolume;
      percAgua = tempPercAgua;
      menuIndex = 0;
    }
    delay(250); 
  }

  // Botão VERMELHO: Cancela edições de menu
  if (digitalRead(BTN_VERMELHO) == LOW) {
    if (menuIndex > 0) { 
      bipCancela();
      tempVolume = volumeTotal;
      tempPercAgua = percAgua;
      menuIndex = 0;
      delay(250);
    }
  }

  // Botão VERDE: Confirma Menu / Inicia Processo
  if (digitalRead(BTN_VERDE) == LOW) {
    bipSutil();
    if (menuIndex == 0) {
      iniciarCiclo(); // INICIA A DOSAGEM
    } else {
      volumeTotal = tempVolume;
      percAgua = tempPercAgua;
      menuIndex = 0;
      delay(250);
    }
  }

  // Botões AZUL (+) e PRETO (-)
  if (menuIndex == 1) { 
    if (digitalRead(BTN_AZUL) == LOW) { tempVolume += 10; bipSutil(); delay(150); }
    if (digitalRead(BTN_PRETO) == LOW && tempVolume > 10) { tempVolume -= 10; bipSutil(); delay(150); }
  } 
  else if (menuIndex == 2) { 
    if (digitalRead(BTN_AZUL) == LOW && tempPercAgua < 100) { tempPercAgua += 5; bipSutil(); delay(150); }
    if (digitalRead(BTN_PRETO) == LOW && tempPercAgua > 0) { tempPercAgua -= 5; bipSutil(); delay(150); }
  } 
  else if (menuIndex == 3) { // PURGA MANUAL
    digitalWrite(SOLENOIDE_1, (digitalRead(BTN_PRETO) == LOW) ? HIGH : LOW);
    digitalWrite(SOLENOIDE_2, (digitalRead(BTN_AZUL) == LOW) ? HIGH : LOW);
  } 
  else {
    digitalWrite(SOLENOIDE_1, LOW);
    digitalWrite(SOLENOIDE_2, LOW);
  }
}

// --- CICLO DE DOSAGEM ---
void iniciarCiclo() {
  bipIniciar();
  
  // TRAVA DE DEDO: Obriga o usuário a soltar o botão Verde antes de iniciar de verdade
  // Isso impede que um "quique" elétrico atravesse o circuito.
  while(digitalRead(BTN_VERDE) == LOW) { delay(10); }
  delay(50); 

  dosando = true;
  pulsosS1 = 0;
  pulsosS2 = 0;
  ultimosPulsosS1 = -1; 
  ultimosPulsosS2 = -1;
  tempoInicioDosagem = millis(); // Marca o momento exato que iniciou
  
  // Calcula a cota de cada válvula considerando o Fator de Calibração
  float volAgua = volumeTotal * (percAgua / 100.0);
  float volMistura = volumeTotal - volAgua;
  
  alvoPulsosS1 = volAgua * PULSOS_POR_ML;
  alvoPulsosS2 = volMistura * PULSOS_POR_ML;

  digitalWrite(LED_VERDE, HIGH);
  if (alvoPulsosS1 > 0) digitalWrite(SOLENOIDE_1, HIGH);
  if (alvoPulsosS2 > 0) digitalWrite(SOLENOIDE_2, HIGH);
}

void executarDosagem() {
  // TRAVA DE SEGURANÇA NO CANCELAMENTO: 
  // O botão vermelho só tem permissão para cancelar após 500ms do inicio. 
  // Isso mata aquele encerramento "fantasma" que ocorria antes da hora.
  if (digitalRead(BTN_VERMELHO) == LOW && (millis() - tempoInicioDosagem > 500)) {
    pararAtuadores();
    bipCancela();
    dosando = false;
    delay(300);
    return;
  }

  // Verifica metas individuais e fecha válvulas de forma independente
  if (pulsosS1 >= alvoPulsosS1) digitalWrite(SOLENOIDE_1, LOW);
  if (pulsosS2 >= alvoPulsosS2) digitalWrite(SOLENOIDE_2, LOW);

  // Conclusão total do processo
  if (pulsosS1 >= alvoPulsosS1 && pulsosS2 >= alvoPulsosS2) {
    pararAtuadores();
    bipSucesso();
    dosando = false;
    return;
  }

  // Atualiza o Display apenas quando um pulso novo é computado
  if (pulsosS1 != ultimosPulsosS1 || pulsosS2 != ultimosPulsosS2) {
    display.clearDisplay();
    display.setTextSize(1);
    display.setCursor(20, 0);
    display.println(F("--- DOSANDO ---"));
    
    display.setCursor(0, 20);
    display.print(F("Agua: ")); display.print(pulsosS1); display.print(F(" / ")); display.print(alvoPulsosS1);
    
    display.setCursor(0, 35);
    display.print(F("Mist: ")); display.print(pulsosS2); display.print(F(" / ")); display.print(alvoPulsosS2);
    
    display.setCursor(0, 52);
    display.println(F("[VM] Cancelar Fluxo"));
    display.display();
    
    ultimosPulsosS1 = pulsosS1;
    ultimosPulsosS2 = pulsosS2;
  }
}

void pararAtuadores() {
  digitalWrite(SOLENOIDE_1, LOW);
  digitalWrite(SOLENOIDE_2, LOW);
  digitalWrite(LED_VERDE, LOW);
}

// --- ATUALIZAÇÃO DO DISPLAY OLED (MENUS) ---
void atualizarDisplay() {
  display.clearDisplay();
  display.setTextSize(1);
  display.setCursor(0, 0);

  if (menuIndex == 0) {
    display.println(F("--- JDJ PRO: PRONTO ---"));
    display.setCursor(0, 20);
    display.print(F("Volume: ")); display.print(volumeTotal); display.println(F(" mL"));
    display.print(F("Agua S1: ")); display.print(percAgua); display.println(F(" %"));
    display.setCursor(0, 52);
    display.println(F("[VD] Iniciar Dosagem"));
  } 
  else if (menuIndex == 1) {
    display.println(F("MENU [1]: VOLUME TOTAL"));
    display.setTextSize(2);
    display.setCursor(15, 25);
    display.print(tempVolume); display.println(F(" mL"));
  } 
  else if (menuIndex == 2) {
    display.println(F("MENU [2]: MISTURA AGUA"));
    display.setTextSize(2);
    display.setCursor(25, 25);
    display.print(tempPercAgua); display.println(F(" %"));
  } 
  else if (menuIndex == 3) {
    display.println(F("MENU [3]: DESPEJO"));
    display.setCursor(0, 25);
    display.println(F("Segure para Purga:"));
    display.setCursor(0, 40);
    display.println(F("[PR] Solenoide 1 (Ag)"));
    display.println(F("[AZ] Solenoide 2"));
  }

  if (menuIndex == 1 || menuIndex == 2) {
    display.setTextSize(1);
    display.setCursor(0, 52);
    display.println(F("[AZ]+ [PR]- [VD]Salva"));
  }

  display.display();
}

// --- AVISOS SONOROS (BUZZER) ---
void bipSutil() { tone(BUZZER, 600, 20); delay(20); }
void bipLigar() { tone(BUZZER, 800, 100); delay(100); tone(BUZZER, 1200, 100); delay(100); tone(BUZZER, 1600, 150); delay(150); }
void bipIniciar() { tone(BUZZER, 1000, 80); delay(80); }
void bipSucesso() { tone(BUZZER, 1400, 100); delay(100); tone(BUZZER, 1800, 200); delay(200); }
void bipCancela() { tone(BUZZER, 400, 300); delay(300); }
