/*
   PROJETO: JDJ LITE - Sistema de Envasadora Automática
   AUTOR: JDJ AUTOMAÇÃO
   CURSO: Automação Industrial - FATEC Bauru
   PLACA: ESP32 
*/

#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>

// --- MAPEAMENTO DE PINOS ---
#define SCREEN_WIDTH 128
#define SCREEN_HEIGHT 64
#define OLED_RESET    -1
Adafruit_SSD1306 display(SCREEN_WIDTH, SCREEN_HEIGHT, &Wire, OLED_RESET);

#define BTN_INC       12  // Botão Incrementar (+) / Purga Solenoide A
#define BTN_DEC       13  // Botão Decrementar (-) / Purga Solenoide B
#define BTN_OK        14  // Botão Navegação / Confirmar
#define SENSOR_NIVEL  27  // Sensor de Nível de Líquido
#define SOLENOIDE_A   26  // Válvula Solenoide A (Bico Principal)
#define SOLENOIDE_B   25  // Válvula Solenoide B (Purga / Auxiliar)
#define BUZZER        32  // Buzzer para Avisos Sonoros

// --- VARIÁVEIS GLOBAIS ---
int menuIndex = 0;             // Navegação do menu: 0 (Pronto), 1 (Volume), 2 (Tempo), 3 (Purga)
int volumeDesejado = 250;      // Volume alvo em mL
int tempoEnvaseMs = 1500;      // Tempo de abertura da solenoide (ms)
bool emProcesso = false;       // Flag de estado do processo

// Variáveis temporárias para edição de parâmetros
int tempVolumeDesejado = 250;
int tempTempoEnvaseMs = 1500;

// Controle de Debounce
unsigned long ultimoDebounce = 0;
const unsigned long DEBOUNCE_DELAY = 180; // ms

// --- FUNÇÕES DE ÁUDIO (BIPS BEM LEVES E SUTIS) ---
void tocarSomSuave(int frequencia, int duracaoMs) {
  tone(BUZZER, frequencia, duracaoMs);
  delay(duracaoMs);
  noTone(BUZZER);
}

void bipBotao() {
  tocarSomSuave(2200, 15); // Bip ultra curto e leve ao apertar botão
}

void bipInicioEnvase() {
  tocarSomSuave(1500, 100); // Som leve na abertura do bico
}

void bipSucesso() {
  tocarSomSuave(1200, 40);
  delay(20);
  tocarSomSuave(1600, 60);
}

void bipInicializacao() {
  tocarSomSuave(1800, 30);
  delay(30);
  tocarSomSuave(2200, 40);
}

// --- PROTÓTIPOS DE FUNÇÕES ---
void tratarErroNivel();
void processarBotoes();
void atualizarDisplayMenu();
void executarEnvase();
void tratarFinalizacao();

// --- SETUP ---
void setup() {
  Serial.begin(115200);

  // Inicializa I2C
  Wire.begin(21, 22);

  // Configuração dos Pinos
  pinMode(BTN_INC, INPUT_PULLUP);
  pinMode(BTN_DEC, INPUT_PULLUP);
  pinMode(BTN_OK, INPUT_PULLUP);
  pinMode(SENSOR_NIVEL, INPUT_PULLUP);

  pinMode(SOLENOIDE_A, OUTPUT);
  pinMode(SOLENOIDE_B, OUTPUT);
  pinMode(BUZZER, OUTPUT);

  digitalWrite(SOLENOIDE_A, LOW);
  digitalWrite(SOLENOIDE_B, LOW);
  digitalWrite(BUZZER, LOW);

  // Inicialização do Display OLED
  if (!display.begin(SSD1306_SWITCHCAPVCC, 0x3C)) {
    Serial.println(F("Erro ao inicializar o Display SSD1306!"));
    while (1) { delay(100); }
  }

  bipInicializacao();

  display.clearDisplay();
  display.setTextColor(SSD1306_WHITE);
  display.setTextSize(1);
  display.setCursor(20, 20);
  display.println(F("JDJ LITE v2.0"));
  display.setCursor(15, 40);
  display.println(F("Iniciando Sistema..."));
  display.display();

  delay(1200);
  atualizarDisplayMenu();
}

// --- LOOP PRINCIPAL ---
void loop() {
  // Verificação simples do nível de reservatório
  if (digitalRead(SENSOR_NIVEL) == LOW) {
    tratarErroNivel();
    return;
  }

  processarBotoes();

  if (!emProcesso) {
    static unsigned long ultimaAtualizacao = 0;
    if (millis() - ultimaAtualizacao > 200) {
      ultimaAtualizacao = millis();
      atualizarDisplayMenu();
    }
  }
}

// --- PROCESSAMENTO DE BOTÕES E NAVEGAÇÃO ---
void processarBotoes() {
  if ((millis() - ultimoDebounce) < DEBOUNCE_DELAY) return;

  static bool prevOkState = HIGH;
  static bool prevIncState = HIGH;
  static bool prevDecState = HIGH;

  bool currentOkState = digitalRead(BTN_OK);
  bool currentIncState = digitalRead(BTN_INC);
  bool currentDecState = digitalRead(BTN_DEC);

  // BOTÃO OK: Navegação entre os 3 Menus
  if (currentOkState == LOW && prevOkState == HIGH) {
    ultimoDebounce = millis();
    bipBotao();

    if (menuIndex == 0) {
      tempVolumeDesejado = volumeDesejado;
      tempTempoEnvaseMs = tempoEnvaseMs;
      menuIndex = 1;
    } 
    else if (menuIndex == 1) {
      menuIndex = 2;
    } 
    else if (menuIndex == 2) {
      menuIndex = 3;
    } 
    else if (menuIndex == 3) {
      // Salva alterações e retorna à Tela Principal (Pronto)
      volumeDesejado = tempVolumeDesejado;
      tempoEnvaseMs = tempTempoEnvaseMs;
      digitalWrite(SOLENOIDE_A, LOW);
      digitalWrite(SOLENOIDE_B, LOW);
      menuIndex = 0;
    }
    atualizarDisplayMenu();
  }

  // AÇÕES NA TELA PRINCIPAL (PRONTO)
  if (menuIndex == 0) {
    if (currentIncState == LOW && prevIncState == HIGH && !emProcesso) {
      ultimoDebounce = millis();
      executarEnvase();
    }
  }

  // AÇÕES NO MENU 1: AJUSTE DE VOLUME
  else if (menuIndex == 1) {
    if (currentIncState == LOW && prevIncState == HIGH) {
      ultimoDebounce = millis();
      bipBotao();
      tempVolumeDesejado += 10;
      if (tempVolumeDesejado > 5000) tempVolumeDesejado = 5000;
      atualizarDisplayMenu();
    }
    if (currentDecState == LOW && prevDecState == HIGH) {
      ultimoDebounce = millis();
      bipBotao();
      tempVolumeDesejado -= 10;
      if (tempVolumeDesejado < 10) tempVolumeDesejado = 10;
      atualizarDisplayMenu();
    }
  }

  // AÇÕES NO MENU 2: AJUSTE DE TEMPO DE ENVASE
  else if (menuIndex == 2) {
    if (currentIncState == LOW && prevIncState == HIGH) {
      ultimoDebounce = millis();
      bipBotao();
      tempTempoEnvaseMs += 100;
      if (tempTempoEnvaseMs > 60000) tempTempoEnvaseMs = 60000;
      atualizarDisplayMenu();
    }
    if (currentDecState == LOW && prevDecState == HIGH) {
      ultimoDebounce = millis();
      bipBotao();
      tempTempoEnvaseMs -= 100;
      if (tempTempoEnvaseMs < 100) tempTempoEnvaseMs = 100;
      atualizarDisplayMenu();
    }
  }

  // AÇÕES NO MENU 3: DESPEJO LIVRE / PURGA MANUAL
  else if (menuIndex == 3) {
    if (currentIncState == LOW) {
      digitalWrite(SOLENOIDE_A, HIGH);
    } else {
      digitalWrite(SOLENOIDE_A, LOW);
    }

    if (currentDecState == LOW) {
      digitalWrite(SOLENOIDE_B, HIGH);
    } else {
      digitalWrite(SOLENOIDE_B, LOW);
    }
  }

  prevOkState = currentOkState;
  prevIncState = currentIncState;
  prevDecState = currentDecState;
}

// --- ATUALIZAÇÃO DO DISPLAY OLED ---
void atualizarDisplayMenu() {
  display.clearDisplay();
  display.setTextColor(SSD1306_WHITE);
  display.setTextSize(1);
  display.setCursor(0, 0);

  switch (menuIndex) {
    case 0:
      display.println(F("--- JDJ LITE: PRONTO ---"));
      display.setCursor(0, 20);
      display.printf("Vol Alvo: %d mL\n", volumeDesejado);
      display.printf("Tempo: %.1f s\n", tempoEnvaseMs / 1000.0);
      display.setCursor(0, 52);
      display.println(F("[+] INICIAR ENVASE"));
      break;

    case 1:
      display.println(F("MENU 1/3: VOLUME ALVO"));
      display.setTextSize(2);
      display.setCursor(15, 22);
      display.printf("%d mL", tempVolumeDesejado);
      display.setTextSize(1);
      display.setCursor(0, 44);
      display.println(F("[-]Dec  [+]Inc"));
      display.setCursor(0, 55);
      display.println(F("[OK] Proximo"));
      break;

    case 2:
      display.println(F("MENU 2/3: TEMPO ENVASE"));
      display.setTextSize(2);
      display.setCursor(15, 22);
      display.printf("%d ms", tempTempoEnvaseMs);
      display.setTextSize(1);
      display.setCursor(0, 44);
      display.println(F("[-]Dec  [+]Inc"));
      display.setCursor(0, 55);
      display.println(F("[OK] Proximo"));
      break;

    case 3:
      display.println(F("MENU 3/3: DESPEJO LIVRE"));
      display.setCursor(0, 18);
      display.println(F("Segure p/ Acionar:"));
      display.setCursor(0, 32);
      display.println(F("[+] Bico Solenoide A"));
      display.setCursor(0, 44);
      display.println(F("[-] Bico Solenoide B"));
      display.setCursor(0, 55);
      display.println(F("[OK] Salvar e Sair"));
      break;
  }

  display.display();
}

// --- CICLO DE ENVASE ---
void executarEnvase() {
  emProcesso = true;
  bipInicioEnvase();

  display.clearDisplay();
  display.setTextSize(1);
  display.setCursor(0, 0);
  display.println(F("  >>> ENVASANDO... <<<  "));
  display.setCursor(0, 22);
  display.printf("Volume: %d mL\n", volumeDesejado);
  display.setCursor(0, 45);
  display.println(F("Solenoide A: ATIVA"));
  display.display();

  // Aciona o bico (Solenoide A) pelo tempo configurado
  digitalWrite(SOLENOIDE_A, HIGH);
  delay(tempoEnvaseMs);
  digitalWrite(SOLENOIDE_A, LOW);

  tratarFinalizacao();
  emProcesso = false;
}

// --- TRATAMENTO DE NIVEL BAIXO ---
void tratarErroNivel() {
  digitalWrite(SOLENOIDE_A, LOW);
  digitalWrite(SOLENOIDE_B, LOW);

  display.clearDisplay();
  display.setTextSize(1);
  display.setCursor(5, 10);
  display.println(F("! ALARME DE NIVEL !"));
  display.setCursor(0, 28);
  display.println(F("Reservatorio Vazio"));
  display.println(F("Abasteca o sistema..."));
  display.display();

  tocarSomSuave(800, 80);
  delay(150);
}

// --- TRATAMENTO DE FINALIZAÇÃO ---
void tratarFinalizacao() {
  display.clearDisplay();
  display.setTextSize(1);
  display.setCursor(10, 20);
  display.println(F("ENVASE CONCLUIDO!"));
  display.setCursor(15, 40);
  display.println(F("Ciclo Finalizado"));
  display.display();

  bipSucesso();
  delay(1200);
  atualizarDisplayMenu();
}
